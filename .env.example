# AirPrint PDF Stack - Environment Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# General Settings
# =============================================================================

# Timezone (uses TZ database names)
TZ=UTC

# =============================================================================
# AirPrint Service Configuration
# =============================================================================

# Container settings
AIRPRINT_CONTAINER_NAME=airprint-cups
AIRPRINT_HOSTNAME=airprint-server

# Printer settings (visible to Apple devices)
PRINTER_NAME=Virtual-PDF
PRINTER_DESCRIPTION=AirPrint Virtual PDF Printer
PRINTER_LOCATION=Home Network

# PDF output directory inside container
PDF_OUTPUT_DIR=/pdfs

# =============================================================================
# PDF Gallery Configuration
# =============================================================================

# Container name for the gallery service
GALLERY_CONTAINER_NAME=pdf-gallery

# Port for the PDF gallery web interface
GALLERY_PORT=8081

# =============================================================================
# FileBrowser Configuration
# =============================================================================

# Container name for FileBrowser
FILEBROWSER_CONTAINER_NAME=pdf-filebrowser

# Port for FileBrowser web interface
FILEBROWSER_PORT=8080

# =============================================================================
# Volume Configuration
# =============================================================================

# Host path for PDF storage (relative or absolute)
PDF_HOST_PATH=./pdfs

# Volume names
PDF_VOLUME_NAME=airprint-pdfs
CUPS_CONFIG_VOLUME=airprint-cups-config
CUPS_SPOOL_VOLUME=airprint-cups-spool
FILEBROWSER_DB_VOLUME=airprint-filebrowser-db

# =============================================================================
# Network Configuration
# =============================================================================

# Docker network name
NETWORK_NAME=airprint-network
